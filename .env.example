# Charkle Web Server Configuration
PORT=3417
HOST=0.0.0.0

# Directory for SQLite database, cached media, thumbnails, and local sync mirror
CHARKLE_DATA_DIR=.charkle-data

# Optional signing secret for session cookies & encrypted credential storage (auto-generated on first run if omitted)
CHARKLE_AUTH_SECRET=

# Optional public origin URL used for OAuth callbacks (e.g. https://charkle.example.com)
CHARKLE_PUBLIC_URL=

# Optional Cloud AI provider API keys (can also be configured in the Web Settings UI)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=

# Optional Google Drive OAuth client credentials (for bidirectional /.charkle/ sync with macOS)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional WebDAV password (can also be configured in the Web Settings UI)
WEBDAV_PASSWORD=
