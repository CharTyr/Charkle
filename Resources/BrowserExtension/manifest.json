{
  "manifest_version": 3,
  "name": "Charkle",
  "short_name": "Charkle",
  "version": "1.3.0",
  "description": "一键收藏网页、图片与灵感卡片，支持 X、Pixiv、Bluesky、Threads、Instagram 与小红书作者画作与收藏的批量整理采集。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "收藏到 Charkle",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://mobile.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://mobile.twitter.com/*",
        "https://bsky.app/*",
        "https://www.bsky.app/*",
        "https://threads.net/*",
        "https://www.threads.net/*",
        "https://threads.com/*",
        "https://www.threads.com/*",
        "https://instagram.com/*",
        "https://www.instagram.com/*",
        "https://m.instagram.com/*"
      ],
      "js": [
        "x-bridge-loader.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "打开 Charkle 面板"
    },
    "quick-capture-page": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "快捷收藏当前网页到 Charkle"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/charkle-light.svg",
        "icons/charkle-dark.svg",
        "icons/icon-32.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    },
    {
      "resources": [
        "page-bridge.js"
      ],
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://mobile.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://mobile.twitter.com/*",
        "https://bsky.app/*",
        "https://www.bsky.app/*",
        "https://threads.net/*",
        "https://www.threads.net/*",
        "https://threads.com/*",
        "https://www.threads.com/*",
        "https://instagram.com/*",
        "https://www.instagram.com/*",
        "https://m.instagram.com/*"
      ]
    }
  ]
}
